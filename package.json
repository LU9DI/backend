{
  "name": "backend",
  "version": "1.0.0",
  "description": "API do SaaS de Reputação com IA",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "build": "node -e \"console.log('Filtra.IA build: runtime via tsx (sem tsc)')\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/cnpj.test.ts tests/env.test.ts tests/passwordPolicy.test.ts tests/validate.test.ts tests/mfaTotp.test.ts tests/metrics.test.ts tests/sentiment.test.ts tests/whatsapp.test.ts tests/quota.test.ts tests/complaintOnce.test.ts tests/pdfPlan.test.ts tests/lgpd.test.ts",
    "test:integration": "tsx --test tests/integration.trial.test.ts tests/integration.stripe-webhook.test.ts",
    "test:e2e:stripe": "tsx --test tests/integration.stripe-webhook.test.ts",
    "backfill:sentiment": "tsx scripts/backfillSentiment.ts",
    "backfill:sentiment:ai": "tsx scripts/backfillSentiment.ts --ai"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mapbox/node-pre-gyp": "2.0.3",
    "@sentry/node": "^10.73.0",
    "bcrypt": "6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.0",
    "http-proxy-agent": "9.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "posthog-node": "^5.51.7",
    "resend": "^6.26.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "tar": "7.5.22",
    "tsx": "^4.16.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/sqlite3": "^3.1.11",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "esbuild@0.28.2": true,
    "sqlite3@6.0.1": true
  }
}
