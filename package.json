{
  "name": "backend",
  "version": "1.0.1",
  "description": "API do SaaS de Reputação com IA",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "npx tsx server.ts",
    "build": "tsc",
    "test": "tsx --test tests/**/*.test.ts",
    "test:unit": "tsx --test tests/cnpj.test.ts tests/env.test.ts tests/passwordPolicy.test.ts tests/validate.test.ts tests/mfaTotp.test.ts tests/metrics.test.ts tests/sentiment.test.ts tests/whatsapp.test.ts tests/quota.test.ts tests/complaintOnce.test.ts tests/pdfPlan.test.ts tests/lgpd.test.ts",
    "test:integration": "tsx --test tests/integration.trial.test.ts tests/integration.stripe-webhook.test.ts",
    "test:e2e:stripe": "tsx --test tests/integration.stripe-webhook.test.ts",
    "backfill:sentiment": "tsx scripts/backfillSentiment.ts",
    "backfill:sentiment:ai": "tsx scripts/backfillSentiment.ts --ai",
    "audit": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.1",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.3",
    "tsx": "^4.19.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.11",
    "@types/web-push": "^3.6.4",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "qs": "^6.14.1",
    "tar": "^7.5.2",
    "@tootallnate/once": "^3.0.1"
  }
}
