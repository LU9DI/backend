# ── Servidor ───────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# CORS_ORIGINS=https://seu-frontend.pages.dev

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=troque-por-segredo-longo-minimo-32-caracteres
ADMIN_PASSWORD=MudeEstaSenha123!
ADMIN_EMAIL=admin@seusaas.com
ADMIN_RECOVERY_SECRET=troque-por-chave-longa-de-recuperacao-admin

# Em produção, para testar planos sem Stripe:
# ALLOW_PLAN_SWITCH=1

# ── WebAuthn (digital / Face ID) ───────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Filtra.IA
WEBAUTHN_ORIGIN=http://localhost:3000
# WEBAUTHN_MAX_CREDENTIALS=5

# ── Web Push (alertas críticos no celular/PC) ──────────
# Gerar: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@seusaas.com

# ── n8n (opcional) ─────────────────────────────────────
# N8N_WEBHOOK_URL=
# N8N_STATUS_URL=

# ── Banco ────────────────────────────────────────────
# Dev: SQLite (padrão)
# SQLITE_DB_PATH=/data/database.sqlite
#
# Produção: Supabase Postgres (produção oficial)
# USE_SUPABASE_DB=1
# SUPABASE_DB_HOST=db.seu-projeto.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=troque-pela-senha-do-banco
#
# Alternativamente, DATABASE_URL pode apontar diretamente para qualquer Postgres:
# DATABASE_URL=postgresql://user:pass@host:5432/filtra
# PGSSL=0                    # só localhost
# SQLITE_ALLOW_PROD=1        # somente para testes controlados; não usar em produção        # força SQLite em produção (não recomendado)

# ── IA ──────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER_ORDER=groq,gemini
AI_LOAD_BALANCE=round_robin

# ── E-mail ──────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Filtra.IA <noreply@seudominio.com>"

JOBS_SECRET=troque-por-segredo-do-cron

# ── Stripe ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── PayPal / Mercado Pago ───────────────────────────
# PAYPAL_CLIENT_ID=
# MP_ACCESS_TOKEN=

# ── Filtra Dot (agente de reputação) ───────────────────
# Guias: docs/DOT_LOCAL.md (localhost) e docs/DOT_PRODUCAO.md (produção)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# FILTRA_DOT_ENABLED=1       # obrigatório em produção; opcional no localhost
# FILTRA_DOT_FORCE_ON=1      # liga o monitor agendado (requer FILTRA_DOT_ENABLED=1)
# DOT_AGENT_WORKER_ENABLED=0 # desliga o worker do agente (padrão: ligado junto do Dot)
# DOT_AGENT_WORKER_INTERVAL_MS=300000
# FILTRA_DOT_MONITOR_TICK_MS=300000
# DOT_MISSION_MAX_STEP_ATTEMPTS=3
# DOT_REI_RESPONSE_TOKENS=1800
# DOT_CORPORATIVO_RESPONSE_TOKENS=1200
# DOT_DEMO_MODE=1            # SOMENTE localhost; ignorado em produção

# --- Captação B2B por legítimo interesse (LGPD art. 7º, IX) — DESLIGADO por padrão ---
# Só envia a e-mail corporativo publicado pela própria empresa (base b2b_public_prospect),
# nunca a provedor gratuito nem a órgão público. A mensagem informa origem, base legal e descadastro.
# ACQUISITION_LEGIT_INTEREST=1
# ACQUISITION_LEGIT_DAILY_CAP=10   # 1–30; opt-in tem prioridade e não conta neste teto
# ATENÇÃO: contatos sem opt-in saem por SMTP (SMTP_HOST/PORT/USER/PASS/FROM), nunca pela Resend,
# para não arriscar a conta que envia e-mails transacionais.
