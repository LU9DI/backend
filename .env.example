# ── Servidor ───────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Produção (Vercel + Railway): liste as origens do front
# CORS_ORIGINS=https://seu-app.vercel.app,https://seudominio.com

# Cookies cross-site (produção já usa SameSite=None automaticamente)
# COOKIE_DOMAIN=.seudominio.com
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=troque-por-segredo-longo-minimo-32-caracteres
ADMIN_PASSWORD=MudeEstaSenha123!
ADMIN_EMAIL=admin@seusaas.com
ADMIN_RECOVERY_SECRET=troque-por-chave-longa-de-recuperacao-admin

# ── Banco ──────────────────────────────────────────────
# SQLite (padrão)
# SQLITE_DB_PATH=/data/database.sqlite
# Postgres (quando migrar — ver docs/POSTGRES.md)
# DATABASE_URL=postgresql://user:pass@host:5432/filtra

# ── IA ─────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER_ORDER=groq,gemini
AI_LOAD_BALANCE=round_robin
AI_WEIGHT_GROQ=70
AI_WEIGHT_GEMINI=30
AI_CB_FAILURES=3
AI_CB_COOLDOWN_MS=60000

# ── E-mail ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Filtra.IA <noreply@seudominio.com>"

# ── Stripe ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional: Price IDs fixos do Dashboard (senão usa price_data dinâmico)
# STRIPE_PRICE_INICIAL_MONTHLY=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_ULTRA_MONTHLY=
# STRIPE_PRICE_CORPORATE_MONTHLY=
# STRIPE_PRICE_REI_MONTHLY=
