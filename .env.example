# ── Servidor ───────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# CORS_ORIGINS=https://seu-app.vercel.app

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=troque-por-segredo-longo-minimo-32-caracteres
ADMIN_PASSWORD=MudeEstaSenha123!
ADMIN_EMAIL=admin@seusaas.com
ADMIN_RECOVERY_SECRET=troque-por-chave-longa-de-recuperacao-admin

# Em produção, para testar planos sem Stripe:
# ALLOW_PLAN_SWITCH=1

# ── WebAuthn (digital / Face ID) ───────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Filtra.IA
WEBAUTHN_ORIGIN=http://localhost:3000
# WEBAUTHN_MAX_CREDENTIALS=5

# ── Web Push (alertas críticos no celular/PC) ──────────
# Gerar: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@seusaas.com

# ── n8n (opcional) ─────────────────────────────────────
# N8N_WEBHOOK_URL=
# N8N_STATUS_URL=

# ── Banco ────────────────────────────────────────────
# SQLITE_DB_PATH=/data/database.sqlite
# DATABASE_URL=postgresql://user:pass@host:5432/filtra

# ── IA ──────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_PROVIDER_ORDER=groq,gemini
AI_LOAD_BALANCE=round_robin

# ── E-mail ──────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Filtra.IA <noreply@seudominio.com>"

JOBS_SECRET=troque-por-segredo-do-cron

# ── Stripe ──────────────────────────────────────────
