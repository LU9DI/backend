# ── Servidor ───────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=troque-por-segredo-longo-minimo-32-caracteres
ADMIN_PASSWORD=MudeEstaSenha123!
ADMIN_EMAIL=admin@seusaas.com
ADMIN_RECOVERY_SECRET=troque-por-chave-longa-de-recuperacao-admin

# ── Banco ──────────────────────────────────────────────
# SQLITE_DB_PATH=/data/database.sqlite

# ── IA ─────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Ordem base / fallback
AI_PROVIDER_ORDER=groq,gemini
# Balanceamento: round_robin | weighted | failover
AI_LOAD_BALANCE=round_robin
# Só usado em AI_LOAD_BALANCE=weighted (soma não precisa ser 100)
AI_WEIGHT_GROQ=70
AI_WEIGHT_GEMINI=30
# Circuit breaker: N falhas seguidas → pausa o provider
AI_CB_FAILURES=3
AI_CB_COOLDOWN_MS=60000

# ── E-mail ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Filtra.IA <noreply@seudominio.com>"

# ── Stripe ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
