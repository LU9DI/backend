      "position": [
        0,
        0
      ],
      "webhookId": "filtra-ai-leads"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "lead.crm_sync.requested",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "crm_sync"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.body.event }}",
                    "rightValue": "lead.followup.requested",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "followup"
            }
          ]
        },
        "options": {}
      },
      "id": "route-events",
      "name": "Route Automation Events",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FILTRA_API_URL + '/api/n8n/inbound/automation-result' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Filtra-Secret",
              "value": "={{ $env.FILTRA_INBOUND_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { lead_id: $json.body.lead_id, action: 'hubspot_sync', status: 'pending' } }}",
        "options": {}
      },
      "id": "crm-pending",
      "name": "CRM Sync - Mark Pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FILTRA_API_URL + '/api/n8n/inbound/automation-result' }}",
        "sendHeaders": true,
